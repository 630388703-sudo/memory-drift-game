{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "app/LandscapeMemoryGame.tsx",
    "app/pixel-*.ts",
    "app/memory-audio.ts",
    "app/memory-storage.ts",
    "app/memory-recall.ts",
    "standalone/main.tsx",
    "vite-env.d.ts"
  ]
}
